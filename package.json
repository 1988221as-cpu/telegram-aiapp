{
  "name": "lingxi-context",
  "private": true,
  "version": "1.2.3",
  "description": "HumanSense",
  "author": "HumanSense团队",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "tsx server.ts --port 3000 --host 0.0.0.0",
    "build": "vite build && esbuild server.ts --platform=node --format=esm --packages=external --bundle --minify --outfile=dist/server.js",
    "start": "node server.ts",
    "build:exe": "npm run build && npx electron-builder --win",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test server/*.test.ts"
  },
  "build": {
    "appId": "com.lingxicontext.app",
    "productName": "HumanSense",
    "extraMetadata": {
      "main": "main.cjs"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/@libsql/**/*",
      "node_modules/@libsql*/**/*",
      "node_modules/libsql/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "1988221as-cpu",
        "repo": "telegram-aiapp"
      }
    ],
    "win": {
      "icon": "public/app-icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@libsql/client": "^0.18.0",
    "@types/busboy": "^1.5.5",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "input": "^1.0.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socks": "2.8.10",
    "telegram": "^2.26.22",
    "unpdf": "^2.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
